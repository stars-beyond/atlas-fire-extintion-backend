# Imagem do RAG da equipe no Atlas: o Dockerfile do Carlin (rag/Dockerfile, mantido igual ao repositório dele)
# mais a camada atlas_pg, que guarda as coleções no pgvector do Atlas em vez do Qdrant.
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
WORKDIR /app
COPY requirements.lock.txt .
RUN pip install --no-cache-dir -r requirements.lock.txt
COPY backend ./backend
COPY data ./data
COPY atlas_pg ./atlas_pg
EXPOSE 8000
CMD ["uvicorn", "atlas_pg.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
